{
  "name": "shubhtalk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "env-cmd -e dev -- vite",
    "build": "env-cmd -e dev -- vite build && node scripts/generate-sitemap.js",
    "start-dev": "env-cmd -e dev -- vite",
    "build-dev": "env-cmd -e dev -- vite build && node scripts/generate-sitemap.js",
    "start-stage": "env-cmd -e stage -- vite",
    "build-stage": "env-cmd -e stage -- vite build && node scripts/generate-sitemap.js",
    "start-prod": "env-cmd -e prod -- vite",
    "build-prod": "env-cmd -e prod -- vite build && SITE_URL=https://shubhastro.ai node scripts/generate-sitemap.js",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
