    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "sass": "^1.93.0",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.7"
  }
