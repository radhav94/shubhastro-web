    "@tailwindcss/vite": "^4.1.13",
    "@vis.gl/react-google-maps": "^1.5.5",
    "agora-rtc-react": "^2.5.0",
    "agora-rtc-sdk-ng": "^4.24.1",
    "agora-rtm-sdk": "^1.5.1",
    "axios": "^1.12.2",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "env-cmd": "^11.0.0",
    "face-api.js": "^0.22.2",
    "firebase": "^12.6.0",
    "formik": "^2.4.6",
    "framer-motion": "^12.23.19",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.544.0",
    "mediabunny": "^1.35.1",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
